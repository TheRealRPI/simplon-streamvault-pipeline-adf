{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "title",
    "type",
    "year"
  ],
  "properties": {
    "_id": {
      "type": "string"
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "directors": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "genre": {
      "type": "string"
    },
    "note": {
      "$ref": "#/$defs/Double"
    },
    "note_imdb": {
      "$ref": "#/$defs/Double"
    },
    "pagesNumber": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "year": {
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "$defs": {
    "Double": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "$numberDouble": {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          }
        }
      ]
    }
  }
}