{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "client",
    "date",
    "media",
    "prix"
  ],
  "properties": {
    "_id": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "media": {
      "type": "string"
    },
    "prix": {
      "$ref": "#/$defs/Double"
    }
  },
  "$defs": {
    "Double": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "$numberDouble": {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          }
        }
      ]
    }
  }
}