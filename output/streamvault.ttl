<http://streamvault.example/ontology> a owl:Ontology ;
    rdfs:label "Ontologie StreamVault"@fr ;
    rdfs:comment "Ontologie du catalogue StreamVault : medias (films, livres), clients et commandes."@fr ;
    owl:versionInfo "1.0" .

sv:aPourActeur a owl:ObjectProperty ;
    rdfs:label "a pour acteur"@fr ;
    rdfs:comment "Personne jouant dans le film."@fr ;
    rdfs:domain sv:Film ;
    rdfs:range sv:Personne .

sv:aPourAnnee a owl:DatatypeProperty ;
    rdfs:label "a pour annee"@fr ;
    rdfs:comment "Annee de sortie (film) ou de publication (livre)."@fr ;
    rdfs:domain sv:Media ;
    rdfs:range xsd:integer .

sv:aPourAuteur a owl:ObjectProperty ;
    rdfs:label "a pour auteur"@fr ;
    rdfs:comment "Personne ayant ecrit le livre."@fr ;
    rdfs:domain sv:Livre ;
    rdfs:range sv:Personne .

sv:aPourClient a owl:ObjectProperty ;
    rdfs:label "a pour client"@fr ;
    rdfs:comment "Client ayant passe la commande."@fr ;
    rdfs:domain sv:Commande ;
    rdfs:range sv:Client .

sv:aPourCodePostal a owl:DatatypeProperty ;
    rdfs:label "a pour code postal"@fr ;
    rdfs:comment "Code postal de residence du client."@fr ;
    rdfs:domain sv:Client ;
    rdfs:range xsd:string .

sv:aPourCommune a owl:DatatypeProperty ;
    rdfs:label "a pour commune"@fr ;
    rdfs:comment "Commune de residence du client."@fr ;
    rdfs:domain sv:Client ;
    rdfs:range xsd:string .

sv:aPourDate a owl:DatatypeProperty ;
    rdfs:label "a pour date"@fr ;
    rdfs:comment "Date et heure de la commande (ISO 8601)."@fr ;
    rdfs:domain sv:Commande ;
    rdfs:range xsd:dateTime .

sv:aPourGenre a owl:DatatypeProperty ;
    rdfs:label "a pour genre"@fr ;
    rdfs:comment "Genre cinematographique du film ('Non renseigne' est exclu)."@fr ;
    rdfs:domain sv:Film ;
    rdfs:range xsd:string .

sv:aPourMedia a owl:ObjectProperty ;
    rdfs:label "a pour media"@fr ;
    rdfs:comment "Media achete via la commande."@fr ;
    rdfs:domain sv:Commande ;
    rdfs:range sv:Media .

sv:aPourNbPages a owl:DatatypeProperty ;
    rdfs:label "a pour nombre de pages"@fr ;
    rdfs:comment "Nombre de pages du livre."@fr ;
    rdfs:domain sv:Livre ;
    rdfs:range xsd:integer .

sv:aPourNom a owl:DatatypeProperty ;
    rdfs:label "a pour nom"@fr ;
    rdfs:comment "Nom de famille du client."@fr ;
    rdfs:domain sv:Client ;
    rdfs:range xsd:string .

sv:aPourNomComplet a owl:DatatypeProperty ;
    rdfs:label "a pour nom complet"@fr ;
    rdfs:comment "Nom usuel de la personne (acteur, realisateur, auteur)."@fr ;
    rdfs:domain sv:Personne ;
    rdfs:range xsd:string .

sv:aPourNote a owl:DatatypeProperty ;
    rdfs:label "a pour note"@fr ;
    rdfs:comment "Note moyenne du media : note IMDB pour un film, note des lecteurs pour un livre."@fr ;
    rdfs:domain sv:Media ;
    rdfs:range xsd:double .

sv:aPourNoteImdb a owl:DatatypeProperty ;
    rdfs:label "a pour note IMDB"@fr ;
    rdfs:comment "Note IMDB du film, sur 10."@fr ;
    rdfs:domain sv:Film ;
    rdfs:range xsd:double .

sv:aPourPrenom a owl:DatatypeProperty ;
    rdfs:label "a pour prenom"@fr ;
    rdfs:comment "Prenom du client."@fr ;
    rdfs:domain sv:Client ;
    rdfs:range xsd:string .

sv:aPourPrix a owl:DatatypeProperty ;
    rdfs:label "a pour prix"@fr ;
    rdfs:comment "Prix paye lors de la commande, en euros."@fr ;
    rdfs:domain sv:Commande ;
    rdfs:range xsd:decimal .

sv:aPourRealisateur a owl:ObjectProperty ;
    rdfs:label "a pour realisateur"@fr ;
    rdfs:comment "Personne ayant realise le film."@fr ;
    rdfs:domain sv:Film ;
    rdfs:range sv:Personne .

sv:aPourTitre a owl:DatatypeProperty ;
    rdfs:label "a pour titre"@fr ;
    rdfs:comment "Titre du media."@fr ;
    rdfs:domain sv:Media ;
    rdfs:range xsd:string .

