sv:Media a owl:Class ;
    rdfs:label "Media"@fr ;
    rdfs:comment "Ouvre du catalogue StreamVault, film ou livre."@fr .

sv:Film a owl:Class ;
    rdfs:label "Film"@fr ;
    rdfs:comment "Film du catalogue : titre, annee, genre, realisateurs, casting, note IMDB. Correspond a schema:Movie (schema.org)."@fr ;
    rdfs:subClassOf sv:Media .

sv:Livre a owl:Class ;
    rdfs:label "Livre"@fr ;
    rdfs:comment "Livre du catalogue : titre, auteur, annee, nombre de pages, note. Correspond a schema:Book (schema.org)."@fr ;
    rdfs:subClassOf sv:Media .

sv:Commande a owl:Class ;
    rdfs:label "Commande"@fr ;
    rdfs:comment "Achat d'un media par un client, a un prix donne et a une date donnee. Correspond a schema:Order (schema.org)."@fr .

sv:Client a owl:Class ;
    rdfs:label "Client"@fr ;
    rdfs:comment "Client inscrit a StreamVault (identifie par ses nom, prenom et code postal)."@fr .

sv:Personne a owl:Class ;
    rdfs:label "Personne"@fr ;
    rdfs:comment "Personnalite liee a un media : acteur, realisateur, auteur. Correspond a schema:Person (schema.org)."@fr .

